[
  {
    "scenarioId": "auth_form",
    "name": "User Authentication Form",
    "url": "https://auth.internal.service/login",
    "viewport": { "width": 1200, "height": 800 },
    "elements": [
      {
        "id": "el_email",
        "selector": "#email-input",
        "tagName": "INPUT",
        "role": "textbox",
        "label": "Email Address",
        "value": "user.test@corporation.org",
        "boundingBox": { "x": 100, "y": 150, "width": 320, "height": 40 },
        "isSensitive": true,
        "expectedPlaceholder": "YOUR_EMAIL",
        "isActionable": true
      },
      {
        "id": "el_password",
        "selector": "#password-input",
        "tagName": "INPUT",
        "role": "textbox",
        "label": "Account Password",
        "value": "TopSecretPassword123!",
        "boundingBox": { "x": 100, "y": 210, "width": 320, "height": 40 },
        "isSensitive": true,
        "expectedPlaceholder": "YOUR_PASSWORD",
        "isActionable": true
      },
      {
        "id": "el_submit",
        "selector": "#login-submit-btn",
        "tagName": "BUTTON",
        "role": "button",
        "label": "Sign In to Account",
        "value": "Sign In",
        "boundingBox": { "x": 100, "y": 270, "width": 140, "height": 44 },
        "isSensitive": false,
        "expectedPlaceholder": null,
        "isActionable": true
      },
      {
        "id": "el_forgot",
        "selector": "#forgot-password-link",
        "tagName": "A",
        "role": "link",
        "label": "Forgot Password?",
        "value": "Forgot Password?",
        "boundingBox": { "x": 260, "y": 280, "width": 160, "height": 24 },
        "isSensitive": false,
        "expectedPlaceholder": null,
        "isActionable": true
      },
      {
        "id": "el_notice",
        "selector": ".security-notice",
        "tagName": "P",
        "role": "paragraph",
        "label": "Security Notice",
        "value": "Protected by 256-bit encryption. Do not share credentials.",
        "boundingBox": { "x": 100, "y": 340, "width": 400, "height": 20 },
        "isSensitive": false,
        "expectedPlaceholder": null,
        "isActionable": false
      }
    ]
  },
